# Attest API — copy to api/.env and fill in. Never commit real secrets.

PORT=5001
NODE_ENV=development

# Postgres (Supabase connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Auth
JWT_SECRET=replace-with-long-random-string
# Leave blank in production. Local OTP bypass only when NODE_ENV≠production.
ATTEST_TEST_LOGIN_EMAIL=test@bl.students.amrita.edu
ATTEST_TEST_LOGIN_CODE=123456

# Microsoft Entra (campus Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/login/callback
MICROSOFT_CAMPUS_TENANT_ID=

# Browser origin(s) allowed to call this API (comma-separated). Required in production.
# Local default allows the Next.js app.
WEB_ORIGIN=http://localhost:3001

# NLP FastAPI
NLP_URL=http://localhost:8001

# Email (Resend)
RESEND_API_KEY=
# Must be a verified domain sender (resend.dev is rejected by the mail queue)
RESEND_FROM=Attest <noreply@your-domain.edu>

# Optional Redis for Socket.IO multi-instance
# REDIS_URL=redis://localhost:6379

# Supabase Storage (idea/profile images). Prefer service role so uploads bypass Storage RLS.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_… or legacy service_role JWT (not sb_publishable_…)
# SUPABASE_SECRET_KEY=  # fallback if SERVICE_ROLE unset; publishable/anon needs write policies
# SUPABASE_BUCKET_NAME=embedra-images
